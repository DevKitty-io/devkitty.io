{
  "name": "devkitty.io",
  "description": "DevKitty website & docs",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "theme": "node scripts/themeGenerator.js",
    "dev": "node scripts/themeGenerator.js && concurrently \"node scripts/themeGenerator.js --watch\" \"hugo server\"",
    "start": "npm run dev",
    "build": "node scripts/themeGenerator.js && hugo --gc --minify",
    "preview": "node scripts/themeGenerator.js && hugo server --disableFastRender -e production --minify",
    "update-modules": "hugo mod get -u ./... && hugo mod tidy",
    "format": "prettier -w ."
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "concurrently": "^9.2.1",
    "hugo-extended": "^0.169.0",
    "prettier": "^3.8.3",
    "prettier-plugin-go-template": "0.0.15",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwind-bootstrap-grid": "^7.0.0",
    "tailwindcss": "^4.3.0"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.5",
    "adm-zip": "^0.6.1"
  }
}
